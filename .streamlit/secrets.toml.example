## Copy this file to `.streamlit/secrets.toml` and fill values with your API keys
## DO NOT commit `.streamlit/secrets.toml` to git (it's ignored via .gitignore)

## Google Gemini
GOOGLE_API_KEY = "your-google-api-key-here"

## OpenAI
OPENAI_API_KEY = "your-openai-api-key-here"

## Anthropic Claude
ANTHROPIC_API_KEY = "your-anthropic-api-key-here"

## X.AI Grok
XAI_API_KEY = "your-xai-api-key-here"

## Any other secrets (e.g., Alpha Vantage) - kept locally
# ALPHA_VANTAGE_KEY = "your-alpha-vantage-key-here"
